# Copie este arquivo para .env e preencha com seus valores reais.
# O .env nunca deve ser enviado ao GitHub (veja .gitignore).

SECRET_KEY=troque-por-uma-chave-secreta-do-django
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Defina como True somente se for usar PostgreSQL (senão o projeto usa SQLite)
USE_POSTGRES=False
DB_NAME=biblioteca_db
DB_USER=postgres
DB_PASSWORD=senha
DB_HOST=localhost
DB_PORT=5432
